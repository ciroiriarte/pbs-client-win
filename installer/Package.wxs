<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?ifndef BuildVersion ?>
    <?define BuildVersion = "1.0.0.0" ?>
  <?endif?>

  <?ifndef PublishDir ?>
    <?define PublishDir = "..\publish\" ?>
  <?endif?>

  <?ifndef SourceDir ?>
    <?define SourceDir = "..\\" ?>
  <?endif?>

  <Package Name="PBS Client for Windows"
           Manufacturer="PBS Client for Windows Open Source Project"
           Version="$(var.BuildVersion)"
           UpgradeCode="9B2A4E81-3C8D-4F12-8E3A-7B5D9C1E2F3A"
           Scope="perMachine"
           Language="1033">

    <MajorUpgrade DowngradeErrorMessage="A newer version of PBS Client for Windows is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- UI Customization & Non-affiliation Notice -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />

    <!-- Configurable Antivirus Exclusions Property (Default: 1 = Enabled) -->
    <Property Id="AV_EXCLUSIONS" Value="1" />

    <!-- Directory Layout -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="pbs-client-win" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="PROGRAMDATAFOLDER" Name="pbs-client-win">
        <Directory Id="LOGSFOLDER" Name="logs" />
      </Directory>
    </StandardDirectory>

    <!-- Component Group: Binaries & System PATH -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <!-- CLI Binary -->
      <Component Id="C_PbsCliExe" Guid="3E4D5F6A-7B8C-9D0E-1F2A-3B4C5D6E7F8A">
        <File Id="F_pbs_client_win_exe" Source="$(var.PublishDir)pbs-client-win.exe" KeyPath="yes" />
        <Environment Id="E_Path" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
      </Component>

      <!-- Windows Supervisor Service Binary & Registration -->
      <Component Id="C_PbsServiceExe" Guid="4F5E6D7C-8B9A-0E1F-2A3B-4C5D6E7F8A9B">
        <File Id="F_Pbs_Service_exe" Source="$(var.PublishDir)Pbs.Service.exe" KeyPath="yes" />
        <ServiceInstall Id="S_PbsService"
                        Type="ownProcess"
                        Name="pbs-client-win"
                        DisplayName="pbs-client-win Backup Scheduler"
                        Description="Background scheduler and supervisor service for pbs-client-win. Independent open-source tool, not affiliated with or endorsed by Proxmox Server Solutions GmbH."
                        Arguments="run"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem">
          <ServiceConfig DelayedAutoStart="yes" OnInstall="yes" OnReinstall="yes" />
        </ServiceInstall>
        <ServiceControl Id="SC_PbsService"
                        Name="pbs-client-win"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <!-- License File -->
      <Component Id="C_License" Guid="5A6B7C8D-9E0F-1A2B-3C4D-5E6F7A8B9C0D">
        <File Id="F_LICENSE" Source="$(var.SourceDir)LICENSE" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Component Group: ProgramData Files & ACLs -->
    <ComponentGroup Id="ProgramDataComponents">
      <!-- Root ProgramData Directory and Sample Config -->
      <Component Id="C_ProgramDataConfig" Directory="PROGRAMDATAFOLDER" Guid="6B7C8D9E-0F1A-2B3C-4D5E-6F7A8B9C0D1E">
        <CreateFolder>
          <util:PermissionEx User="NT AUTHORITY\SYSTEM" GenericAll="yes" />
          <util:PermissionEx User="BUILTIN\Administrators" GenericAll="yes" />
          <util:PermissionEx User="BUILTIN\Users" GenericRead="yes" GenericExecute="yes" Read="yes" />
        </CreateFolder>
        <File Id="F_config_json_sample" Source="config.json.sample" KeyPath="yes" />
      </Component>

      <!-- Logs Directory (Restricted Write Access) -->
      <Component Id="C_ProgramDataLogs" Directory="LOGSFOLDER" Guid="7C8D9E0F-1A2B-3C4D-5E6F-7A8B9C0D1E2F">
        <CreateFolder>
          <util:PermissionEx User="NT AUTHORITY\SYSTEM" GenericAll="yes" />
          <util:PermissionEx User="BUILTIN\Administrators" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </ComponentGroup>

    <!-- Feature Tree. The CLI and service are published self-contained single-file, so each exe
         bundles the .NET runtime and no separate dependency harvest is needed. -->
    <Feature Id="MainFeature" Title="PBS Client for Windows" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ProgramDataComponents" />
    </Feature>

    <!-- Custom Actions: Non-fatal Microsoft Defender Exclusion Setup/Teardown -->
    <!-- WixQuietExec (util ext) reads its command line from a property named identically to the
         deferred custom action; SetProperty populates it in the execute sequence just before the CA. -->
    <!-- Braceless PowerShell: MSI Formatted-field processing strips '{' '}', which would corrupt a
         try/catch. The action is Return="ignore" and uses -ErrorAction SilentlyContinue, so a host
         without Defender (e.g. Server Core with it removed) never blocks the install. -->
    <SetProperty Id="CA_AddDefenderExclusions"
                 Sequence="execute"
                 Value="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Add-MpPreference -ExclusionProcess pbs-client-win.exe,Pbs.Service.exe -ExclusionPath '[PROGRAMDATAFOLDER]' -ErrorAction SilentlyContinue&quot;"
                 Before="CA_AddDefenderExclusions" />

    <SetProperty Id="CA_RemoveDefenderExclusions"
                 Sequence="execute"
                 Value="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Remove-MpPreference -ExclusionProcess pbs-client-win.exe,Pbs.Service.exe -ExclusionPath '[PROGRAMDATAFOLDER]' -ErrorAction SilentlyContinue&quot;"
                 Before="CA_RemoveDefenderExclusions" />

    <CustomAction Id="CA_AddDefenderExclusions"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="CA_RemoveDefenderExclusions"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="CA_AddDefenderExclusions" After="InstallFiles" Condition="AV_EXCLUSIONS = &quot;1&quot; AND NOT Installed" />
      <Custom Action="CA_RemoveDefenderExclusions" Before="RemoveFiles" Condition="AV_EXCLUSIONS = &quot;1&quot; AND (REMOVE = &quot;ALL&quot; OR UPGRADINGPRODUCTCODE)" />
    </InstallExecuteSequence>
  </Package>
</Wix>
