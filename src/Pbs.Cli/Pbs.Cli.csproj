<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The shipped binary name; the service, installer, and PATH all expect pbs-client-win.exe. -->
    <AssemblyName>pbs-client-win</AssemblyName>
    <RootNamespace>Pbs.Cli</RootNamespace>
    <!-- Linux/macOS build only net8.0. Windows also builds net8.0-windows, which references Pbs.Vss
         and gets real VSS support (the 'WINDOWS' symbol is defined for that target). -->
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net8.0;net8.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pbs.Abstractions\Pbs.Abstractions.csproj" />
    <ProjectReference Include="..\Pbs.Protocol\Pbs.Protocol.csproj" />
    <ProjectReference Include="..\Pbs.Chunker\Pbs.Chunker.csproj" />
    <ProjectReference Include="..\Pbs.Pxar\Pbs.Pxar.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.EndsWith('-windows'))">
    <ProjectReference Include="..\Pbs.Vss\Pbs.Vss.csproj" />
  </ItemGroup>

</Project>
